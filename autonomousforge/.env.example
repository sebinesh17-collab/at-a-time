# Database
POSTGRES_PASSWORD=forge_secure_password_change_in_production
DATABASE_URL=postgresql://forge:forge_secure_password_change_in_production@localhost:5432/autonomousforge

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=7

# NVIDIA API
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Master API Key (generated on first setup)
MASTER_API_KEY=

# Security
BCRYPT_ROUNDS=12
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Rate Limiting
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MINUTES=15
API_RATE_LIMIT=100
API_RATE_WINDOW_MINUTES=1

# File Upload
MAX_FILE_SIZE_MB=100
UPLOAD_DIR=/app/uploads
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown,text/csv,application/json,application/xml,text/html,text/css,application/javascript,application/typescript,text/x-python,text/x-java,text/x-kotlin,text/x-swift,text/x-dart,application/sql,application/yaml,application/zip,image/*,audio/*,video/*

# Worker
WORKER_CONCURRENCY=10
WORKER_TIMEOUT_SECONDS=300
WORKER_MAX_MEMORY_MB=512

# Monitoring
METRICS_ENABLED=true
LOG_LEVEL=INFO

# Frontend
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000